{
  "Version": "2012-10-17",
  "Statement": [ {
    "Sid": "EksMayAssumeThisRoleForUsmsClustersInThisAccountOnly",
    "Effect": "Allow",
    "Principal": { "Service": "eks.amazonaws.com" },
    "Action": "sts:AssumeRole",
    "Condition": {
      "StringEquals": { "aws:SourceAccount": "000000000000" },
      "ArnLike":      { "aws:SourceArn": "arn:aws:eks:us-east-1:000000000000:cluster/usms-*" }
    }
  } ]
}
