{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteOwnFunctionLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:000000000000:log-group:/aws/lambda/usms-*:*"
    },
    {
      "Sid": "ReadTranscriptObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::usms-student-data/*"
    }
  ]
}
