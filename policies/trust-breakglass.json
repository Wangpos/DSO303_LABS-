{
  "Version": "2012-10-17",
  "Statement": [ {
    "Sid": "OnlyUsmsAdmin01WithMfaAndTheIncidentExternalId",
    "Effect": "Allow",
    "Principal": { "AWS": "arn:aws:iam::000000000000:user/usms-admin-01" },
    "Action": "sts:AssumeRole",
    "Condition": {
      "Bool":         { "aws:MultiFactorAuthPresent": "true" },
      "StringEquals": { "sts:ExternalId": "usms-breakglass-suspend-scaling" }
    }
  } ]
}
